! Module  : freq_m
! Purpose : frequency data storage & manipulation
!
! Copyright 2016-2026 Rich Townsend

#:include 'em.inc'

#:include 'forum.inc'

module freq_m

   ! Uses

   use forum_m, only: RD, sort_indices

   use interp_m
   use utils_m

   use f95_lapack

   use ISO_FORTRAN_ENV

   ! No implicit typing

   implicit none (type, external)

   ! Parameter definitions

   integer, parameter :: L_MAX = 3

   ! Derived-type definitions

   type :: freq_t
      real(RD), allocatable :: nu(:)
      real(RD), allocatable :: dnu(:)
      integer, allocatable  :: n_pg(:)
      real(RD), allocatable :: E_norm(:)
      integer               :: n = 0
   contains
      private
      procedure, public :: Delta_nu
   end type freq_t

   type :: ratio_t
      real(RD), allocatable :: nu(:)
      real(RD), allocatable :: ratio(:)
      integer               :: n = 0
   end type ratio_t

   ! Module variables

   type(freq_t), save :: fr_obs_m(0:L_MAX) ! Observed frequencies
   type(freq_t), save :: fr_mod_m(0:L_MAX) ! Raw model frequencies

   ! Interfaces

   interface freq_t
      module procedure freq_t_
   end interface freq_t

   ! Access specifiers

   private

   public :: L_MAX
   public :: freq_t
   public :: set_obs_freqs
   public :: set_mod_freqs
   public :: get_obs_freqs
   public :: get_mod_freqs
   public :: apply_cubic_correction
   public :: apply_combined_correction
   public :: eval_chisq_radial
   public :: eval_chisq_all
   public :: eval_chisq_ratios

   ! Procedures

contains

   function freq_t_(nu, dnu, E_norm, n_pg) result(fr)

      real(RD), intent(in) :: nu(:)
      real(RD), intent(in) :: dnu(:)
      real(RD), intent(in) :: E_norm(:)
      integer, intent(in)  :: n_pg(:)
      type(freq_t)         :: fr

      integer :: i(SIZE(nu))

      @:CHECK_BOUNDS(SIZE(dnu), SIZE(nu))
      @:CHECK_BOUNDS(SIZE(E_norm), SIZE(nu))
      @:CHECK_BOUNDS(SIZE(n_pg), SIZE(nu))

      ! Construct the freq_t

      i = sort_indices(nu)

      fr%nu = nu(i)
      fr%dnu = dnu(i)

      fr%E_norm = E_norm(i)

      fr%n_pg = n_pg(i)

      fr%n = SIZE(nu)

      ! Finish

      return

   end function freq_t_

   !****

   function Delta_nu(fr)

      class(freq_t), intent(in) :: fr
      real(RD)                  :: Delta_nu

      real(RD) :: a
      real(RD) :: b

      ! Determine Delta_nu using a linear fit

      call linear_fit(REAL(fr%n_pg, RD), fr%nu, fr%dnu, a, b)

      Delta_nu = b

      ! Finish

      return

   end function Delta_nu

   !****

   subroutine set_obs_freqs(l, fr)

      integer, intent(in)      :: l
      type(freq_t), intent(in) :: fr

      ! Set observational frequency data for harmonic degree l

      @:ASSERT(l >= 0 .AND. l <= L_MAX, 'invalid harmonic degree')

      fr_obs_m(l) = fr

      ! Finish

      return

   end subroutine set_obs_freqs

   !****

   subroutine set_mod_freqs(l, fr)

      integer, intent(in)      :: l
      type(freq_t), intent(in) :: fr

      ! Set model frequency data for harmonic degree l

      @:ASSERT(l >= 0 .AND. l <= L_MAX, 'invalid harmonic degree')

      fr_mod_m(l) = fr

      ! Finish

      return

   end subroutine set_mod_freqs

   !****

   function get_obs_freqs(l) result(fr)

      integer, intent(in) :: l
      type(freq_t)        :: fr

      ! Get observational frequency data for harmonic degree l

      @:ASSERT(l >= 0 .AND. l <= L_MAX, 'invalid harmonic degree')

      fr = fr_obs_m(l)

      ! Finish

      return

   end function get_obs_freqs

   !****

   function get_mod_freqs(l) result(fr)

      integer, intent(in) :: l
      type(freq_t)        :: fr

      ! Get model frequency data for harmonic degree l

      @:ASSERT(l >= 0 .AND. l <= L_MAX, 'invalid harmonic degree')

      fr = fr_mod_m(l)

      ! Finish

      return

   end function get_mod_freqs

   !****

   subroutine eval_chisq_radial(fr_mod, fr_obs, chisq)

      type(freq_t), intent(in) :: fr_mod(0:)
      type(freq_t), intent(in) :: fr_obs(0:)
      real(RD), intent(out)    :: chisq

      ! Evaluate the chisq for observed vs model frequencies, radial
      ! modes only

      chisq = SUM((fr_mod(0)%nu - fr_obs(0)%nu)**2/fr_obs(0)%dnu**2)

      ! Finish

   end subroutine eval_chisq_radial

   !****

   subroutine eval_chisq_all(fr_mod, fr_obs, chisq)

      type(freq_t), intent(in) :: fr_mod(0:)
      type(freq_t), intent(in) :: fr_obs(0:)
      real(RD), intent(out)    :: chisq

      integer :: l

      ! Evaluate the chisq for observed vs model frequencies, all
      ! modes

      chisq = 0._RD

      do l = 0, 3
         chisq = chisq + SUM((fr_mod(l)%nu - fr_obs(l)%nu)**2/fr_obs(l)%dnu**2)
      end do

      ! Finish

   end subroutine eval_chisq_all

   !****

   subroutine eval_chisq_ratios(fr_mod, fr_obs, chisq)

      type(freq_t), intent(in) :: fr_mod(0:)
      type(freq_t), intent(in) :: fr_obs(0:)
      real(RD), intent(out)    :: chisq

      type(ratio_t)         :: rt_010_obs
      type(ratio_t)         :: rt_02_obs
      type(ratio_t)         :: rt_13_obs
      type(ratio_t)         :: rt_010_mod
      type(ratio_t)         :: rt_02_mod
      type(ratio_t)         :: rt_13_mod
      integer               :: n
      real(RD), allocatable :: J(:,:)
      integer               :: i
      integer               :: l
      integer               :: k
      real(RD), allocatable :: dr010_dnu(:)
      real(RD), allocatable :: dr02_dnu(:)
      real(RD), allocatable :: dr13_dnu(:)
      real(RD), allocatable :: delta_ratio(:)
      real(RD), allocatable :: C(:,:)
      real(RD), allocatable :: inv_C_delta_ratio(:)

      ! Evaluate the chisq for observed vs model frequency *ratios*

      ! First, evaluate frequency ratios for both observed and model
      ! data (interpolating the ratios for the latter onto the
      ! frequencies of the former)

      call eval_ratios_r010_(fr_obs, rt_010_obs)
      call eval_ratios_r02_(fr_obs, rt_02_obs)
      call eval_ratios_r13_(fr_obs, rt_13_obs)

      call eval_ratios_r010_(fr_mod, rt_010_mod, rt_010_obs)
      call eval_ratios_r02_(fr_mod, rt_02_mod, rt_02_obs)
      call eval_ratios_r13_(fr_mod, rt_13_mod, rt_13_obs)

      ! Construct the Jacobian matrix (with errors folded in) by
      ! performing finite-differencing on the observed frequencies

      n = rt_010_obs%n + rt_02_obs%n + rt_13_obs%n

      allocate(J(n,SUM(fr_obs%n)))

      i = 1

      do l = 0, L_MAX
         do k = 1, fr_obs(l)%n

            ! Evaluate the derivatives of the ratios

            call eval_ratios_deriv_(fr_obs, k, l, eval_ratios_r010_, dr010_dnu)
            call eval_ratios_deriv_(fr_obs, k, l, eval_ratios_r02_, dr02_dnu)
            call eval_ratios_deriv_(fr_obs, k, l, eval_ratios_r13_, dr13_dnu)

            ! Store in a column of the Jacobian matrix, folding in the
            ! error associated with this observed frequency

            J(:,i) = [dr010_dnu,dr02_dnu,dr13_dnu] * fr_obs(l)%dnu(k)

            i = i + 1

         end do
      end do


      ! Evaluate the covariance matrix

      C = MATMUL(J, TRANSPOSE(J))

      ! Evaluate the chisq

      delta_ratio = &
         [rt_010_mod%ratio,rt_02_mod%ratio,rt_13_mod%ratio] - &
         [rt_010_obs%ratio,rt_02_obs%ratio,rt_13_obs%ratio]

      inv_C_delta_ratio = delta_ratio

      call LA_GESV(C, inv_C_delta_ratio)

      chisq = DOT_PRODUCT(delta_ratio, inv_C_delta_ratio)

      ! Finish

      return

   end subroutine eval_chisq_ratios

   !****

   subroutine apply_cubic_correction(fr_mod, fr_obs, fr_cor)

      type(freq_t), intent(in)  :: fr_obs(0:)
      type(freq_t), intent(in)  :: fr_mod(0:)
      type(freq_t), intent(out) :: fr_cor(0:)

      real(RD) :: X, y, XtX, Xty
      integer  :: i, l
      real(RD) :: a3 ! Coefficient of cubic term

      call match_modes_(fr_mod, fr_obs, fr_cor)

      XtX = 0._RD
      Xty = 0._RD
      X = 0._RD
      y = 0._RD

      do l = 0, 3
         if (fr_obs(l)%n < 1) cycle
         if (fr_cor(l)%n < 1) cycle
         do i = 1, fr_obs(l)%n
            X = fr_cor(l)%nu(i)**3/fr_cor(l)%E_norm(i)/fr_obs(l)%dnu(i)
            y = (fr_obs(l)%nu(i)-fr_cor(l)%nu(i))/fr_obs(l)%dnu(i)

            XtX = XtX + X*X
            Xty = Xty + X*y
         end do
      end do

      a3 = Xty/XtX

      do l = 0, 3
         if (fr_obs(l)%n < 1) cycle
         if (fr_cor(l)%n < 1) cycle
         do i = 1, fr_obs(l)%n
            fr_cor(l)%nu(i) = fr_cor(l)%nu(i) &
               + a3*fr_cor(l)%nu(i)**3/fr_cor(l)%E_norm(i)
         end do
      end do

   end subroutine apply_cubic_correction

   !****

   subroutine apply_combined_correction(fr_mod, fr_obs, fr_cor)

      type(freq_t), intent(in)  :: fr_mod(0:)
      type(freq_t), intent(in)  :: fr_obs(0:)
      type(freq_t), intent(out) :: fr_cor(0:)

      real(RD) :: X(2), y, XtX(2,2), XtXi(2,2), Xty(2), detXtX
      integer  :: i, l
      real(RD) :: a1 ! Coefficient of inverse term
      real(RD) :: a3 ! Coefficient of cubic term

      call match_modes_(fr_mod, fr_obs, fr_cor)

      XtX = 0._RD
      Xty = 0._RD
      X = 0._RD
      y = 0._RD

      do l = 0, 3
         if (fr_obs(l)%n < 1) cycle
         if (fr_cor(l)%n < 1) cycle
         do i = 1, fr_obs(l)%n
            X(1) = fr_cor(l)%nu(i)**(-1)/fr_cor(l)%E_norm(i)/fr_obs(l)%dnu(i)
            X(2) = fr_cor(l)%nu(i)**3/fr_cor(l)%E_norm(i)/fr_obs(l)%dnu(i)
            y = (fr_obs(l)%nu(i)-fr_cor(l)%nu(i))/fr_obs(l)%dnu(i)

            XtX(1,1) = XtX(1,1) + X(1)*X(1)
            XtX(1,2) = XtX(1,2) + X(1)*X(2)
            XtX(2,2) = XtX(2,2) + X(2)*X(2)
            Xty(1) = Xty(1) + X(1)*y
            Xty(2) = Xty(2) + X(2)*y
         end do
      end do

      XtX(2,1) = XtX(1,2)

      XtXi(1,1) = XtX(2,2)
      XtXi(2,2) = XtX(1,1)
      XtXi(1,2) = -XtX(1,2)
      XtXi(2,1) = -XtX(2,1)

      detXtX = XtX(1,1)*XtX(2,2) - XtX(1,2)*XtX(2,1)
      XtXi = XtXi/detXtX

      a1 = XtXi(1,1)*Xty(1) + XtXi(1,2)*Xty(2)
      a3 = XtXi(2,1)*Xty(1) + XtXi(2,2)*Xty(2)

      do l = 0, 3
         if (fr_obs(l)%n < 1) cycle
         if (fr_cor(l)%n < 1) cycle
         do i = 1, fr_obs(l)%n
            fr_cor(l)%nu(i) = fr_cor(l)%nu(i) &
               + (a1*fr_cor(l)%nu(i)**(-1) + a3*fr_cor(l)%nu(i)**3) &
               /fr_cor(l)%E_norm(i)
         end do
      end do

   end subroutine apply_combined_correction

   !****

   subroutine eval_ratios_r010_(fr, rt, rt_in)

      type(freq_t), intent(in)            :: fr(0:)
      type(ratio_t), intent(out)          :: rt
      type(ratio_t), intent(in), optional :: rt_in

      integer               :: i0
      integer               :: i1
      integer               :: end0
      integer               :: end1
      real(RD), allocatable :: x0(:)
      real(RD), allocatable :: y0(:)
      real(RD), allocatable :: x1(:)
      real(RD), allocatable :: y1(:)
      real(RD), allocatable :: x(:)
      real(RD), allocatable :: y(:)
      integer, allocatable  :: j(:)

      ! Evaluate r01 and r10 frequency ratios, following Roxburgh &
      ! Vorontsov (2003), eq. (8). The ratio data are returned in
      ! rt. If rt_in is present, they are first interpolated onto the
      ! frequency abscissa of rt_in

      ! Set up indices into the frequency arrays

      associate(Delta_nu => fr(0)%Delta_nu())

         i0 = FINDLOC(fr(0)%nu >= fr(1)%nu(1) - 0.75_RD*Delta_nu, .TRUE., DIM=1)
         @:ASSERT_DEBUG(i0 > 0, 'invalid i0')

         i1 = FINDLOC(fr(1)%nu >= fr(0)%nu(i0) - 0.75_RD*Delta_nu, .TRUE., DIM=1)
         @:ASSERT_DEBUG(i0 > 0, 'invalid i1')

         end0 = FINDLOC(fr(0)%nu <= fr(1)%nu(fr(1)%n) + 0.75_RD*Delta_nu, .TRUE., DIM=1, BACK=.TRUE.)
         @:ASSERT_DEBUG(end0 > 0, 'invalid end0')

         end1 = FINDLOC(fr(1)%nu <= fr(0)%nu(end0) + 0.75_RD*Delta_nu, .TRUE., DIM=1, BACK=.TRUE.)
         @:ASSERT_DEBUG(end1 > 0, 'invalid end1')

      end associate

      ! Calculate frequency ratios

      ! r01

      associate(n => end0 - i0 - 1)

         x0 = fr(0)%nu(i0+1:i0+n)
         y0 = (fr(0)%nu(i0:i0+n-1) - 4._RD*fr(1)%nu(i1:i1+n-1) + 6._RD*fr(0)%nu(i0+1:i0+n) - &
            4._RD*fr(1)%nu(i1+1:i1+n) + fr(0)%nu(i0+2:i0+n+1)) / 8._RD / (fr(1)%nu(i1+1:i1+n) - fr(1)%nu(i1:i1+n-1))

      end associate

      ! r10

      associate(n => end1 - i1 - 1)

         x1 = fr(1)%nu(i1+1:i1+n)
         y1 = (fr(1)%nu(i1:i1+n-1) - 4._RD*fr(0)%nu(i0:i0+n-1) + 6._RD*fr(1)%nu(i1+1:i1+n) - &
            4._RD*fr(0)%nu(i0+1:i0+n) + fr(1)%nu(i1+2:i1+n+1)) / 8._RD / (fr(0)%nu(i0+1:i0+n) - fr(0)%nu(i0:i0+n-1))

      end associate

      ! Merge the two sets of ratios

      x = [x0,x1]
      y = [y0,y1]

      j = sort_indices(x)

      x = x(j)
      y = y(j)

      ! Store into rt, interpolating if necessary

      if (PRESENT(rt_in)) then

         rt%nu = rt_in%nu
         rt%ratio = interp_vec(x, y, rt%nu, 'MONO')

      else

         rt%nu = x
         rt%ratio = y

      end if

      rt%n = SIZE(rt%nu)

      ! Finish

      return

   end subroutine eval_ratios_r010_

   !****

   subroutine eval_ratios_r02_(fr, rt, rt_in)

      type(freq_t), intent(in)            :: fr(0:)
      type(ratio_t), intent(out)          :: rt
      type(ratio_t), intent(in), optional :: rt_in

      integer               :: i0
      integer               :: i1
      integer               :: i2
      integer               :: end0
      integer               :: end1
      integer               :: end2
      real(RD), allocatable :: x(:)
      real(RD), allocatable :: y(:)

      ! Evaluate r02 frequency ratios, following Roxburgh & Vorontsov
      ! (2003), eqn. (7). The ratio data are returned in rt

      ! Set up indices into the frequency arrays

      associate(Delta_nu => fr(0)%Delta_nu())

         i0 = FINDLOC(fr(0)%nu >= fr(1)%nu(1), .TRUE., DIM=1)
         @:ASSERT_DEBUG(i0 > 0, 'invalid i0')

         i1 = FINDLOC(fr(1)%nu >= fr(0)%nu(i0) - 0.75_RD*Delta_nu, .TRUE., DIM=1)
         @:ASSERT_DEBUG(i1 > 0, 'invalid i1')

         i2 = FINDLOC(fr(2)%nu >= fr(1)%nu(i1), .TRUE., DIM=1)
         @:ASSERT_DEBUG(i2 > 0, 'invalid i2')

         end0 = FINDLOC(fr(0)%nu <= fr(1)%nu(fr(0)%n), .TRUE., DIM=1, BACK=.TRUE.)
         @:ASSERT(end0 > 0, 'invalid end0')

         end1 = FINDLOC(fr(1)%nu <= fr(0)%nu(end0) + 0.75_RD*Delta_nu, .TRUE., DIM=1, BACK=.TRUE.)
         @:ASSERT(end0 > 0, 'invalid end1')

         end2 = FINDLOC(fr(2)%nu <= fr(1)%nu(end1), .TRUE., DIM=1, BACK=.TRUE.)
         @:ASSERT(end0 > 0, 'invalid end2')

      end associate

      ! Calculate frequency ratios

      associate(n => end2 - i2 + 1)

         x = fr(0)%nu(i0:i0+n-1)
         y = (fr(0)%nu(i0:i0+n-1)-fr(2)%nu(i2:i2+n-1)) / (fr(1)%nu(i1+1:i1+n)-fr(1)%nu(i1:i1+n-1))

      end associate

      ! Store into rt, interpolating if necessary

      if (PRESENT(rt_in)) then

         @:ASSERT_DEBUG(ALL(rt_in%nu >= x(1)), 'out-of-bounds')
         @:ASSERT_DEBUG(ALL(rt_in%nu <= x(SIZE(x))), 'out-of-bounds')

         rt%nu = rt_in%nu
         rt%ratio = interp_vec(x, y, rt%nu, 'MONO')

      else

         rt%nu = x
         rt%ratio = y

      end if

      rt%n = SIZE(rt%nu)

      ! Finish

      return

   end subroutine eval_ratios_r02_

   !****

   subroutine eval_ratios_r13_(fr, rt, rt_in)

      type(freq_t), intent(in)            :: fr(0:)
      type(ratio_t), intent(out)          :: rt
      type(ratio_t), intent(in), optional :: rt_in

      integer               :: i0
      integer               :: i1
      integer               :: i3
      integer               :: end0
      integer               :: end1
      integer               :: end3
      real(RD), allocatable :: x(:)
      real(RD), allocatable :: y(:)

      ! Evaluate r13 frequency ratios, following Roxburgh & Vorontsov
      ! (2003), eq. (7). The ratio data are returned in rt

      ! Set up indices into the frequency arrays

      associate(Delta_nu => fr(0)%Delta_nu())

         i1 = FINDLOC(fr(1)%nu >= fr(0)%nu(1), .TRUE., DIM=1)
         @:ASSERT_DEBUG(i1 > 0, 'invalid i1')

         i0 = FINDLOC(fr(0)%nu >= fr(1)%nu(i1) - 0.75_RD*Delta_nu, .TRUE., DIM=1)
         @:ASSERT_DEBUG(i0 > 0, 'invalid i0')

         i3 = FINDLOC(fr(3)%nu >= fr(0)%nu(i0), .TRUE., DIM=1)
         @:ASSERT_DEBUG(i3 > 0, 'invalid i3')

         end1 = FINDLOC(fr(1)%nu <= fr(0)%nu(fr(0)%n), .TRUE., DIM=1, BACK=.TRUE.)
         @:ASSERT_DEBUG(end1 > 0, 'invalid end1')

         end0 = FINDLOC(fr(0)%nu <= fr(1)%nu(end1) + 0.75_RD*Delta_nu, .TRUE., DIM=1, BACK=.TRUE.)
         @:ASSERT_DEBUG(end0 > 0, 'invalid end0')

         end3 = FINDLOC(fr(3)%nu <= fr(0)%nu(end0), .TRUE., DIM=1, BACK=.TRUE.)
         @:ASSERT_DEBUG(end3 > 0, 'invalid end3')

      end associate

      ! Calculate frequency ratios

      associate(n => end3 - i3 + 1)

         x = fr(1)%nu(i1:i1+n-1)
         y = (fr(1)%nu(i1:i1+n-1)-fr(3)%nu(i3:i3+n-1)) / (fr(0)%nu(i0+1:i0+n)-fr(0)%nu(i0:i0+n-1))

      end associate

      ! Store into rt, interpolating if necessary

      if (PRESENT(rt_in)) then

         @:ASSERT_DEBUG(ALL(rt_in%nu >= x(1)), 'out-of-bounds')
         @:ASSERT_DEBUG(ALL(rt_in%nu <= x(SIZE(x))), 'out-of-bounds')

         rt%nu = rt_in%nu
         rt%ratio = interp_vec(x, y, rt%nu, 'MONO')

      else

         rt%nu = x
         rt%ratio = y

      end if

      rt%n = SIZE(rt%nu)

      ! Finish

      return

   end subroutine eval_ratios_r13_

   !****

   subroutine eval_ratios_deriv_(fr, k, l, eval_ratios_, dr_dnu)

      type(freq_t), intent(in) :: fr(0:)
      integer, intent(in)      :: k
      integer, intent(in)      :: l
      interface
         subroutine eval_ratios_(fr, rt, rt_in)
            import freq_t
            import ratio_t
            implicit none (type, external)
            type(freq_t), intent(in)            :: fr(0:)
            type(ratio_t), intent(out)          :: rt
            type(ratio_t), intent(in), optional :: rt_in
         end subroutine eval_ratios_
      end interface
      real(RD), allocatable, intent(out) :: dr_dnu(:)

      real(RD)      :: h
      type(freq_t)  :: fr_a(0:L_MAX)
      type(freq_t)  :: fr_b(0:L_MAX)
      type(ratio_t) :: rt_a
      type(ratio_t) :: rt_b

      ! Evaluate the derivative of ratios with respect to the
      ! frequency fr(l)%nu(k), using finite differences

      ! Choose step size

      h = MAX(1E-5_RD*fr(l)%dnu(k), 1E-6_RD)

      ! Calculate offset frequencies

      fr_a = fr
      fr_a(l)%nu(k) = fr_a(l)%nu(k) - h

      fr_b = fr
      fr_b(l)%nu(k) = fr_b(l)%nu(k) + h

      ! Evaluate ratios at these frequencies

      call eval_ratios_(fr_a, rt_a)
      call eval_ratios_(fr_b, rt_b)

      ! Evaluate the derivative

      dr_dnu = (rt_b%ratio - rt_a%ratio) / (2._RD*h)

      ! Finish

      return

   end subroutine eval_ratios_deriv_

   !****

   subroutine match_modes_(fr_mod, fr_obs, fr_cor)

      ! ported from MESA, see
      ! $MESA_DIR/star/astero/src/astero_support.f:set_to_closest
      ! $MESA_DIR/star/astero/src/astero_support.f:find_closest

      type(freq_t), intent(in)  :: fr_mod(0:3)
      type(freq_t), intent(in)  :: fr_obs(0:3)
      type(freq_t), intent(out) :: fr_cor(0:3)
      integer                   :: l, i, j, j_prev, j_min_dist
      real(RD)                  :: dist, min_dist

      do l = 0, 3
         if (fr_obs(l)%n < 1) cycle
         if (fr_mod(l)%n < 1) cycle

         fr_cor(l) = fr_obs(l)

         j_prev = 0
         do i = 1, fr_obs(l)%n
            ! j = find_closest(fr_obs(l)*nu(i), j_prev)
            min_dist = 1d99
            j_min_dist = -1

            !          do j = j_prev + 1, fr_mod(l)%n
            do j = 1, fr_mod(l)%n
               dist = ABS(fr_mod(l)%nu(j) - fr_obs(l)%nu(i))
               if (j_min_dist <= 0 .or. dist < min_dist) then
                  min_dist = dist
                  j_min_dist = j
               end if
               if (fr_mod(l)%nu(j) > fr_obs(l)%nu(i)) exit
            end do

            j = j_min_dist

            if (j <= 0) stop 'failed to match modes'

            fr_cor(l)%nu(i) = fr_mod(l)%nu(j)
            fr_cor(l)%E_norm(i) = fr_mod(l)%E_norm(j)
            fr_cor(l)%n_pg(i) = fr_mod(l)%n_pg(j)
            j_prev = j
         end do
      end do

   end subroutine match_modes_

   !****

   subroutine match_modes_old_(fr_mod, fr_obs, fr_cor)

      ! match observed modes to model modes one by one
      ! currently naive: just finds nearest mode

      type(freq_t), intent(in)  :: fr_mod(0:3)
      type(freq_t), intent(in)  :: fr_obs(0:3)
      type(freq_t), intent(out) :: fr_cor(0:3)
      integer                   :: i, j, l

      do l = 0, 3
         if (fr_obs(l)%n < 1) cycle
         if (fr_mod(l)%n < 1) cycle

         fr_cor(l) = fr_obs(l)

         do i = 1, fr_obs(l)%n
            j = MINLOC(ABS(fr_mod(l)%nu - fr_obs(l)%nu(i)), DIM=1)
            fr_cor(l)%nu(i) = fr_mod(l)%nu(j)
            fr_cor(l)%E_norm(i) = fr_mod(l)%E_norm(j)
            fr_cor(l)%n_pg(i) = fr_mod(l)%n_pg(j)
         end do
      end do
   end subroutine match_modes_old_

end module freq_m
