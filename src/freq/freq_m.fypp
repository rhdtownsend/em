! Module  : freq_m
! Purpose : frequency data storage & manipulation
!
! Copyright 2016-2026 Rich Townsend

#:include 'em.inc'

#:include 'forum.inc'

module freq_m

   ! Uses

   use forum_m, only: RD, sort_indices

   use interp_m
   use utils_m

   use ISO_FORTRAN_ENV

   ! No implicit typing

   implicit none (type, external)

   ! Parameter definitions

   integer, parameter :: L_MAX = 3

   ! Derived-type definitions

   type :: freq_t
      real(RD), allocatable :: nu(:)
      real(RD), allocatable :: dnu(:)
      integer, allocatable  :: n_pg(:)
      real(RD), allocatable :: E_norm(:)
      integer               :: n = 0
   contains
      private
      procedure, public :: Delta_nu
   end type freq_t

   ! Module variables

   type(freq_t), save :: fr_obs_m(0:L_MAX) ! Observed frequencies
   type(freq_t), save :: fr_mod_m(0:L_MAX) ! Raw model frequencies

   ! Interfaces

   interface freq_t
      module procedure freq_t_
   end interface freq_t

   ! Access specifiers

   private

   public :: L_MAX
   public :: freq_t
   public :: set_obs_freqs
   public :: set_mod_freqs
   public :: get_obs_freqs
   public :: get_mod_freqs
   public :: chi2_radial
   public :: apply_cubic_correction
   public :: apply_combined_correction

contains

   function freq_t_(nu, dnu, E_norm, n_pg) result(fr)

      real(RD), intent(in) :: nu(:)
      real(RD), intent(in) :: dnu(:)
      real(RD), intent(in) :: E_norm(:)
      integer, intent(in)  :: n_pg(:)
      type(freq_t)         :: fr

      integer :: i(SIZE(nu))

      @:CHECK_BOUNDS(SIZE(dnu), SIZE(nu))
      @:CHECK_BOUNDS(SIZE(E_norm), SIZE(nu))
      @:CHECK_BOUNDS(SIZE(n_pg), SIZE(nu))

      ! Construct the freq_t

      i = sort_indices(nu)

      fr%nu = nu(i)
      fr%dnu = dnu(i)

      fr%E_norm = E_norm(i)

      fr%n_pg = n_pg(i)

      fr%n = SIZE(nu)

      ! Finish

      return

   end function freq_t_

   !****

   function Delta_nu(fr)

      class(freq_t), intent(in) :: fr
      real(RD)                  :: Delta_nu

      real(RD) :: a
      real(RD) :: b

      ! Determine Delta_nu using a linear fit

      call linear_fit(REAL(fr%n_pg, RD), fr%nu, fr%dnu, a, b)

      Delta_nu = b

      ! Finish

      return

   end function Delta_nu

   !****

   subroutine set_obs_freqs(l, fr)

      integer, intent(in)      :: l
      type(freq_t), intent(in) :: fr

      ! Set observational frequency data for harmonic degree l

      @:ASSERT(l >= 0 .AND. l <= L_MAX, 'invalid harmonic degree')

      fr_obs_m(l) = fr

      ! Finish

      return

   end subroutine set_obs_freqs

   !****

   subroutine set_mod_freqs(l, fr)

      integer, intent(in)      :: l
      type(freq_t), intent(in) :: fr

      ! Set model frequency data for harmonic degree l

      @:ASSERT(l >= 0 .AND. l <= L_MAX, 'invalid harmonic degree')

      fr_mod_m(l) = fr

      ! Finish

      return

   end subroutine set_mod_freqs

   !****

   function get_obs_freqs(l) result(fr)

      integer, intent(in) :: l
      type(freq_t)        :: fr

      ! Get observational frequency data for harmonic degree l

      @:ASSERT(l >= 0 .AND. l <= L_MAX, 'invalid harmonic degree')

      fr = fr_obs_m(l)

      ! Finish

      return

   end function get_obs_freqs

   !****

   function get_mod_freqs(l) result(fr)

      integer, intent(in) :: l
      type(freq_t)        :: fr

      ! Get model frequency data for harmonic degree l

      @:ASSERT(l >= 0 .AND. l <= L_MAX, 'invalid harmonic degree')

      fr = fr_mod_m(l)

      ! Finish

      return

   end function get_mod_freqs

   !****

   subroutine chi2_radial(fr_mod, fr_obs, chi2)

      type(freq_t), intent(in) :: fr_mod(0:3)
      type(freq_t), intent(in) :: fr_obs(0:3)
      real(RD), intent(out)    :: chi2
      integer                  :: i

      chi2 = 0._RD
      do i = 1, fr_obs(0)%n
         chi2 = chi2 + (fr_mod(0)%nu(i)-fr_obs(0)%nu(i))**2/fr_obs(0)%dnu(i)**2
      end do

   end subroutine chi2_radial

   !****

   subroutine apply_cubic_correction(fr_mod, fr_obs, fr_cor)

      type(freq_t), intent(in)  :: fr_mod(0:3)
      type(freq_t), intent(in)  :: fr_obs(0:3)
      type(freq_t), intent(out) :: fr_cor(0:3)

      real(RD) :: X, y, XtX, Xty
      integer  :: i, l
      real(RD) :: a3 ! Coefficient of cubic term

      call match_modes_(fr_mod, fr_obs, fr_cor)

      XtX = 0._RD
      Xty = 0._RD
      X = 0._RD
      y = 0._RD

      do l = 0, 3
         if (fr_obs(l)%n < 1) cycle
         if (fr_cor(l)%n < 1) cycle
         do i = 1, fr_obs(l)%n
            X = fr_cor(l)%nu(i)**3/fr_cor(l)%E_norm(i)/fr_obs(l)%dnu(i)
            y = (fr_obs(l)%nu(i)-fr_cor(l)%nu(i))/fr_obs(l)%dnu(i)

            XtX = XtX + X*X
            Xty = Xty + X*y
         end do
      end do

      a3 = Xty/XtX

      do l = 0, 3
         if (fr_obs(l)%n < 1) cycle
         if (fr_cor(l)%n < 1) cycle
         do i = 1, fr_obs(l)%n
            fr_cor(l)%nu(i) = fr_cor(l)%nu(i) &
               + a3*fr_cor(l)%nu(i)**3/fr_cor(l)%E_norm(i)
         end do
      end do

   end subroutine apply_cubic_correction

   !****

   subroutine apply_combined_correction(fr_mod, fr_obs, fr_cor)

      type(freq_t), intent(in)  :: fr_mod(0:3)
      type(freq_t), intent(in)  :: fr_obs(0:3)
      type(freq_t), intent(out) :: fr_cor(0:3)

      real(RD) :: X(2), y, XtX(2,2), XtXi(2,2), Xty(2), detXtX
      integer  :: i, l
      real(RD) :: a1 ! Coefficient of inverse term
      real(RD) :: a3 ! Coefficient of cubic term

      call match_modes_(fr_mod, fr_obs, fr_cor)

      XtX = 0._RD
      Xty = 0._RD
      X = 0._RD
      y = 0._RD

      do l = 0, 3
         if (fr_obs(l)%n < 1) cycle
         if (fr_cor(l)%n < 1) cycle
         do i = 1, fr_obs(l)%n
            X(1) = fr_cor(l)%nu(i)**(-1)/fr_cor(l)%E_norm(i)/fr_obs(l)%dnu(i)
            X(2) = fr_cor(l)%nu(i)**3/fr_cor(l)%E_norm(i)/fr_obs(l)%dnu(i)
            y = (fr_obs(l)%nu(i)-fr_cor(l)%nu(i))/fr_obs(l)%dnu(i)

            XtX(1,1) = XtX(1,1) + X(1)*X(1)
            XtX(1,2) = XtX(1,2) + X(1)*X(2)
            XtX(2,2) = XtX(2,2) + X(2)*X(2)
            Xty(1) = Xty(1) + X(1)*y
            Xty(2) = Xty(2) + X(2)*y
         end do
      end do

      XtX(2,1) = XtX(1,2)

      XtXi(1,1) = XtX(2,2)
      XtXi(2,2) = XtX(1,1)
      XtXi(1,2) = -XtX(1,2)
      XtXi(2,1) = -XtX(2,1)

      detXtX = XtX(1,1)*XtX(2,2) - XtX(1,2)*XtX(2,1)
      XtXi = XtXi/detXtX

      a1 = XtXi(1,1)*Xty(1) + XtXi(1,2)*Xty(2)
      a3 = XtXi(2,1)*Xty(1) + XtXi(2,2)*Xty(2)

      do l = 0, 3
         if (fr_obs(l)%n < 1) cycle
         if (fr_cor(l)%n < 1) cycle
         do i = 1, fr_obs(l)%n
            fr_cor(l)%nu(i) = fr_cor(l)%nu(i) &
               + (a1*fr_cor(l)%nu(i)**(-1) + a3*fr_cor(l)%nu(i)**3) &
               /fr_cor(l)%E_norm(i)
         end do
      end do

   end subroutine apply_combined_correction

   !****

   subroutine eval_r010_(fr, fr0, fr1, r010)

      real(RD), intent(in)     :: fr(:)
      type(freq_t), intent(in) :: fr0
      type(freq_t), intent(in) :: fr1
      real(RD), intent(out)    :: r010(:)

      integer               :: i0
      integer               :: i1
      integer               :: end0
      integer               :: end1
      real(RD), allocatable :: x0(:)
      real(RD), allocatable :: y0(:)
      real(RD), allocatable :: x1(:)
      real(RD), allocatable :: y1(:)
      real(RD), allocatable :: x(:)
      real(RD), allocatable :: y(:)
      integer, allocatable  :: j(:)

      @:CHECK_BOUNDS(SIZE(r010), SIZE(fr))

      ! Evaluate r01 and r10 frequency ratios, following Roxburgh &
      ! Vorontsov (2003), eq. (8)

      ! Set up indices into the frequency arrays

      associate(Delta_nu => fr0%Delta_nu())

         i0 = FINDLOC(fr0%nu >= fr1%nu(1) - 0.75_RD*Delta_nu, .TRUE., DIM=1)
         @:ASSERT_DEBUG(i0 > 0, 'invalid i0')

         i1 = FINDLOC(fr1%nu >= fr0%nu(i0) - 0.75_RD*Delta_nu, .TRUE., DIM=1)
         @:ASSERT_DEBUG(i0 > 0, 'invalid i0')

         end0 = FINDLOC(fr0%nu <= fr1%nu(fr1%n) + 0.75_RD*Delta_nu, .TRUE., DIM=1, BACK=.TRUE.)
         @:ASSERT_DEBUG(end0 > 0, 'invalid end0')

         end1 = FINDLOC(fr1%nu <= fr0%nu(end0) + 0.75_RD*Delta_nu, .TRUE., DIM=1, BACK=.TRUE.)
         @:ASSERT_DEBUG(end1 > 0, 'invalid end1')

      end associate

      ! Calculate frequency ratios

      ! r01

      associate(n => end0 - i0 - 1)

         x0 = fr0%nu(i0+1:i0+n)
         y0 = (fr0%nu(i0:i0+n-1) - 4._RD*fr1%nu(i1:i1+n-1) + 6._RD*fr0%nu(i0+1:i0+n) - &
            4._RD*fr1%nu(i1+1:i1+n) + fr0%nu(i0+2:i0+n+1)) / 8._RD / (fr1%nu(i1+1:i1+n) - fr1%nu(i1:i1+n-1))

      end associate

      ! r10

      associate(n => end1 - i1 - 1)

         x1 = fr1%nu(i1+1:i1+n)
         y1 = (fr1%nu(i1:i1+n) - 4._RD*fr0%nu(i0:i0+n-1) + 6._RD*fr1%nu(i1+1:i1+n) - &
            4._RD*fr0%nu(i0+1:i0+n) + fr1%nu(i1+2:i1+n+1)) / 8._RD / (fr0%nu(i0+1:i0+n) - fr0%nu(i0:i0+n-1))

      end associate

      ! Merge the two arrays, in frequency order

      x = [x0,x1]
      y = [y0,y1]

      j = sort_indices(x)

      x = x(j)
      y = y(j)

      ! Interpolate onto the abscissa given by fr

      r010 = interp_vec(x, y, fr, 'MONO')

      ! Finish

      return

   end subroutine eval_r010_

   !****

   subroutine eval_r02_(fr, fr0, fr1, fr2, r02)

      real(RD), intent(in)     :: fr(:)
      type(freq_t), intent(in) :: fr0
      type(freq_t), intent(in) :: fr1
      type(freq_t), intent(in) :: fr2
      real(RD), intent(out)    :: r02(:)

      integer               :: i0
      integer               :: i1
      integer               :: i2
      integer               :: end0
      integer               :: end1
      integer               :: end2
      real(RD), allocatable :: x(:)
      real(RD), allocatable :: y(:)

      @:CHECK_BOUNDS(SIZE(r02), SIZE(fr))

      ! Evaluate r02 frequency ratios, following Roxburgh & Vorontsov
      ! (2003), eqn. (7)

      ! Set up indices into the frequency arrays

      associate(Delta_nu => fr0%Delta_nu())

         i0 = FINDLOC(fr0%nu >= fr1%nu(1), .TRUE., DIM=1)
         @:ASSERT_DEBUG(i0 > 0, 'invalid i0')

         i1 = FINDLOC(fr1%nu >= fr0%nu(i0) - 0.75_RD*Delta_nu, .TRUE., DIM=1)
         @:ASSERT_DEBUG(i1 > 0, 'invalid i1')

         i2 = FINDLOC(fr2%nu >= fr1%nu(i1), .TRUE., DIM=1)
         @:ASSERT_DEBUG(i2 > 0, 'invalid i2')

         end0 = FINDLOC(fr0%nu <= fr1%nu(fr0%n), .TRUE., DIM=1, BACK=.TRUE.)
         @:ASSERT(end0 > 0, 'invalid end0')

         end1 = FINDLOC(fr1%nu <= fr0%nu(end0) + 0.75_RD*Delta_nu, .TRUE., DIM=1, BACK=.TRUE.)
         @:ASSERT(end0 > 0, 'invalid end1')

         end2 = FINDLOC(fr2%nu <= fr1%nu(end1), .TRUE., DIM=1, BACK=.TRUE.)
         @:ASSERT(end0 > 0, 'invalid end2')

      end associate

      ! Calculate frequency ratios

      associate(n => end2 - i2 + 1)

         x = fr0%nu(i0:i0+n-1)
         y = (fr0%nu(i0:i0+n-1)-fr2%nu(i2:i2+n-1)) / (fr1%nu(i1+1:i1+n)-fr1%nu(i1:i1+n-1))

      end associate

      ! Interpolate onto the abscissa given by fr

      r02 = interp_vec(x, y, fr, 'MONO')

      ! Finish

      return

   end subroutine eval_r02_

   !****

   subroutine eval_r13_(fr, fr0, fr1, fr3, r13)

      real(RD), intent(in)     :: fr(:)
      type(freq_t), intent(in) :: fr0
      type(freq_t), intent(in) :: fr1
      type(freq_t), intent(in) :: fr3
      real(RD), intent(out)    :: r13(:)

      integer               :: i0
      integer               :: i1
      integer               :: i3
      integer               :: end0
      integer               :: end1
      integer               :: end3
      real(RD), allocatable :: x(:)
      real(RD), allocatable :: y(:)

      @:CHECK_BOUNDS(SIZE(r13), SIZE(fr))

      ! Evaluate r13 frequency ratios, following Roxburgh & Vorontsov
      ! (2003), eq. (7)

      ! Set up indices into the frequency arrays

      associate(Delta_nu => fr0%Delta_nu())

         i1 = FINDLOC(fr1%nu >= fr0%nu(1), .TRUE., DIM=1)
         @:ASSERT_DEBUG(i1 > 0, 'invalid i1')

         i0 = FINDLOC(fr0%nu >= fr1%nu(i1) - 0.75_RD*Delta_nu, .TRUE., DIM=1)
         @:ASSERT_DEBUG(i0 > 0, 'invalid i0')

         i3 = FINDLOC(fr3%nu >= fr0%nu(i0), .TRUE., DIM=1)
         @:ASSERT_DEBUG(i3 > 0, 'invalid i3')

         end1 = FINDLOC(fr1%nu <= fr0%nu(fr0%n), .TRUE., DIM=1, BACK=.TRUE.)
         @:ASSERT_DEBUG(end1 > 0, 'invalid end1')

         end0 = FINDLOC(fr0%nu <= fr1%nu(end1) + 0.75_RD*Delta_nu, .TRUE., DIM=1, BACK=.TRUE.)
         @:ASSERT_DEBUG(end0 > 0, 'invalid end0')

         end3 = FINDLOC(fr3%nu <= fr0%nu(end0), .TRUE., DIM=1, BACK=.TRUE.)
         @:ASSERT_DEBUG(end3 > 0, 'invalid end3')

      end associate

      ! Calculate frequency ratios

      associate(n => end3 - i3 + 1)

         x = fr1%nu(i1:i1+n-1)
         y = (fr1%nu(i1:i1+n-1)-fr3%nu(i3:i3+n-1)) / (fr0%nu(i0+1:i0+n)-fr0%nu(i0:i0+n-1))

      end associate

      ! Interpolate onto the abscissa given by fr

      r13 = interp_vec(x, y, fr, 'MONO')

      ! Finish

      return

   end subroutine eval_r13_

   !****

   subroutine chi2_ratios_(n_r010, n_r02, n_r13, r_freq, r_obs, r_invcov, fr_mod, chi2)

      type(freq_t), intent(in) :: fr_mod(0:3)
      integer, intent(in)      :: n_r010, n_r02, n_r13
      real(RD), intent(in)     :: r_freq(:)
      real(RD), intent(in)     :: r_obs(:)
      real(RD), intent(in)     :: r_invcov(:,:)
      real(RD), intent(out)    :: chi2

      real(RD), allocatable :: r_mod(:)
      integer               :: n_r, i, j

      n_r = n_r010 + n_r02 + n_r13

      allocate(r_mod(n_r))
      r_mod = 0._RD

      if (n_r010 > 0) call eval_r010_(r_freq(1:n_r010), fr_mod(0), fr_mod(1), r_mod(1:n_r010))
      if (n_r02 > 0) call eval_r02_(r_freq(n_r010+1:n_r010+n_r02), &
         fr_mod(0), fr_mod(1), fr_mod(2), r_mod(n_r010+1:n_r010+n_r02))
      if (n_r13 > 0) call eval_r13_(r_freq(n_r010+n_r02+1:n_r), &
         fr_mod(0), fr_mod(1), fr_mod(3), r_mod(n_r010+n_r02+1:n_r))

      chi2 = 0._RD

      do i = 1, n_r
         do j = 1, n_r
            chi2 = chi2 + (r_mod(i)-r_obs(i))*r_invcov(i,j)*(r_mod(j)-r_obs(j))
         end do
      end do

      deallocate(r_mod)

   end subroutine chi2_ratios_

   !****

   subroutine match_modes_(fr_mod, fr_obs, fr_cor)

      ! ported from MESA, see
      ! $MESA_DIR/star/astero/src/astero_support.f:set_to_closest
      ! $MESA_DIR/star/astero/src/astero_support.f:find_closest

      type(freq_t), intent(in)  :: fr_mod(0:3)
      type(freq_t), intent(in)  :: fr_obs(0:3)
      type(freq_t), intent(out) :: fr_cor(0:3)
      integer                   :: l, i, j, j_prev, j_min_dist
      real(RD)                  :: dist, min_dist

      do l = 0, 3
         if (fr_obs(l)%n < 1) cycle
         if (fr_mod(l)%n < 1) cycle

         fr_cor(l) = fr_obs(l)

         j_prev = 0
         do i = 1, fr_obs(l)%n
            ! j = find_closest(fr_obs(l)*nu(i), j_prev)
            min_dist = 1d99
            j_min_dist = -1

            !          do j = j_prev + 1, fr_mod(l)%n
            do j = 1, fr_mod(l)%n
               dist = ABS(fr_mod(l)%nu(j) - fr_obs(l)%nu(i))
               if (j_min_dist <= 0 .or. dist < min_dist) then
                  min_dist = dist
                  j_min_dist = j
               end if
               if (fr_mod(l)%nu(j) > fr_obs(l)%nu(i)) exit
            end do

            j = j_min_dist

            if (j <= 0) stop 'failed to match modes'

            fr_cor(l)%nu(i) = fr_mod(l)%nu(j)
            fr_cor(l)%E_norm(i) = fr_mod(l)%E_norm(j)
            fr_cor(l)%n_pg(i) = fr_mod(l)%n_pg(j)
            j_prev = j
         end do
      end do

   end subroutine match_modes_

   !****

   subroutine match_modes_old_(fr_mod, fr_obs, fr_cor)

      ! match observed modes to model modes one by one
      ! currently naive: just finds nearest mode

      type(freq_t), intent(in)  :: fr_mod(0:3)
      type(freq_t), intent(in)  :: fr_obs(0:3)
      type(freq_t), intent(out) :: fr_cor(0:3)
      integer                   :: i, j, l

      do l = 0, 3
         if (fr_obs(l)%n < 1) cycle
         if (fr_mod(l)%n < 1) cycle

         fr_cor(l) = fr_obs(l)

         do i = 1, fr_obs(l)%n
            j = MINLOC(ABS(fr_mod(l)%nu - fr_obs(l)%nu(i)), DIM=1)
            fr_cor(l)%nu(i) = fr_mod(l)%nu(j)
            fr_cor(l)%E_norm(i) = fr_mod(l)%E_norm(j)
            fr_cor(l)%n_pg(i) = fr_mod(l)%n_pg(j)
         end do
      end do
   end subroutine match_modes_old_

end module freq_m
