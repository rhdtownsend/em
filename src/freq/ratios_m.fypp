! Module  : ratios_m
! Purpose : frequency ratio evaluation
!
! Copyright 2016-2026 Rich Townsend

#:include 'em.inc'

#:include 'forum.inc'

module ratios_m

   ! Uses

   use forum_m, only: RD, sort_indices

   use freqs_m
   use interp_m

   use ISO_FORTRAN_ENV

   ! No implicit typing

   implicit none (type, external)

   ! Derived-type definitions

   type :: ratios_t
      real(RD), allocatable     :: nu(:)
      real(RD), allocatable     :: ratio(:)
      character(3), allocatable :: label(:)
      integer                   :: n = 0
   end type ratios_t

   ! Interfaces

   interface ratios_t
      module procedure ratios_t_
   end interface ratios_t

   ! Access specifiers

   private

   public :: ratios_t
   public :: eval_ratios_deriv

   ! Procedures

contains

   function ratios_t_(fr, ratio_type, rt_ref) result(rt)

      type(freqs_t), intent(in)            :: fr(0:)
      character(*), intent(in)             :: ratio_type
      type(ratios_t), intent(in), optional :: rt_ref
      type(ratios_t)                       :: rt

      real(RD), allocatable     :: x(:)
      real(RD), allocatable     :: y(:)
      character(3), allocatable :: label(:)

      ! Construct the ratios_t from the frequency data in fr. The
      ! ratio_type argument selects which ratios: 'R010' (r01 and r10,
      ! merged into a single sequence), 'R02' or 'R13'. Modes are
      ! paired using their radial orders (fr%n_pg, which must follow
      ! the asymptotic convention established by freqs_t), and a ratio
      ! is evaluated only if all the modes it requires are present
      ! (unlike AMP 1.3, which restricts all ratios to the radial-order
      ! range of r01, and so can omit an r02 at the high-frequency
      ! end). If rt_ref is present, the ratios are interpolated onto
      ! its frequency abscissa

      select case (ratio_type)
      case ('R010')
         call eval_r010_(fr, x, y, label)
      case ('R02')
         call eval_r02_(fr, x, y, label)
      case ('R13')
         call eval_r13_(fr, x, y, label)
      case default
         @:ABORT('invalid ratio_type')
      end select

      ! Store data, interpolating if necessary

      if (PRESENT(rt_ref)) then

         rt%nu = rt_ref%nu
         rt%label = rt_ref%label

         if (rt_ref%n > 0) then

            @:ASSERT(SIZE(x) >= 2, 'too few ratios to interpolate')

            @:ASSERT_DEBUG(ALL(rt_ref%nu >= x(1)), 'out-of-bounds')
            @:ASSERT_DEBUG(ALL(rt_ref%nu <= x(SIZE(x))), 'out-of-bounds')

            rt%ratio = interp_vec(x, y, rt%nu, 'MONO')

         else

            allocate(rt%ratio(0))

         end if

      else

         rt%nu = x
         rt%ratio = y
         rt%label = label

      end if

      rt%n = SIZE(rt%nu)

      ! Finish

      return

   end function ratios_t_

   !****

   subroutine eval_r010_(fr, x, y, label)

      type(freqs_t), intent(in)              :: fr(0:)
      real(RD), allocatable, intent(out)     :: x(:)
      real(RD), allocatable, intent(out)     :: y(:)
      character(3), allocatable, intent(out) :: label(:)

      integer              :: n
      integer              :: i0
      integer              :: i0m
      integer              :: i0p
      integer              :: i1
      integer              :: i1m
      integer              :: i1p
      integer, allocatable :: j(:)

      ! Evaluate r01 and r10 frequency ratios, following Roxburgh &
      ! Vorontsov (2003), eq. (8)

      allocate(x(0))
      allocate(y(0))
      allocate(label(0))

      ! r01(n), at nu(n,0)

      do i0 = 1, fr(0)%n

         n = fr(0)%n_pg(i0)

         i0m = mode_index_(fr(0), n-1)
         i0p = mode_index_(fr(0), n+1)
         i1m = mode_index_(fr(1), n-1)
         i1 = mode_index_(fr(1), n)

         if (i0m == 0 .OR. i0p == 0 .OR. i1m == 0 .OR. i1 == 0) cycle

         x = [x, fr(0)%nu(i0)]
         y = [y, (fr(0)%nu(i0m) - 4._RD*fr(1)%nu(i1m) + 6._RD*fr(0)%nu(i0) - &
            4._RD*fr(1)%nu(i1) + fr(0)%nu(i0p)) / (8._RD*(fr(1)%nu(i1) - fr(1)%nu(i1m)))]
         label = [label, 'r01']

      end do

      ! r10(n), at nu(n,1)

      do i1 = 1, fr(1)%n

         n = fr(1)%n_pg(i1)

         i1m = mode_index_(fr(1), n-1)
         i1p = mode_index_(fr(1), n+1)
         i0 = mode_index_(fr(0), n)
         i0p = mode_index_(fr(0), n+1)

         if (i1m == 0 .OR. i1p == 0 .OR. i0 == 0 .OR. i0p == 0) cycle

         x = [x, fr(1)%nu(i1)]
         y = [y, -(fr(1)%nu(i1m) - 4._RD*fr(0)%nu(i0) + 6._RD*fr(1)%nu(i1) - &
            4._RD*fr(0)%nu(i0p) + fr(1)%nu(i1p)) / (8._RD*(fr(0)%nu(i0p) - fr(0)%nu(i0)))]
         label = [label, 'r10']

      end do

      ! Merge the two sets of ratios

      j = sort_indices(x)

      x = x(j)
      y = y(j)
      label = label(j)

      ! Finish

      return

   end subroutine eval_r010_

   !****

   subroutine eval_r02_(fr, x, y, label)

      type(freqs_t), intent(in)              :: fr(0:)
      real(RD), allocatable, intent(out)     :: x(:)
      real(RD), allocatable, intent(out)     :: y(:)
      character(3), allocatable, intent(out) :: label(:)

      integer :: n
      integer :: i0
      integer :: i1
      integer :: i1m
      integer :: i2m

      ! Evaluate r02 frequency ratios, following Roxburgh & Vorontsov
      ! (2003), eqn. (7)

      allocate(x(0))
      allocate(y(0))
      allocate(label(0))

      ! r02(n), at nu(n,0)

      do i0 = 1, fr(0)%n

         n = fr(0)%n_pg(i0)

         i2m = mode_index_(fr(2), n-1)
         i1m = mode_index_(fr(1), n-1)
         i1 = mode_index_(fr(1), n)

         if (i2m == 0 .OR. i1m == 0 .OR. i1 == 0) cycle

         x = [x, fr(0)%nu(i0)]
         y = [y, (fr(0)%nu(i0) - fr(2)%nu(i2m)) / (fr(1)%nu(i1) - fr(1)%nu(i1m))]
         label = [label, 'r02']

      end do

      ! Finish

      return

   end subroutine eval_r02_

   !****

   subroutine eval_r13_(fr, x, y, label)

      type(freqs_t), intent(in)              :: fr(0:)
      real(RD), allocatable, intent(out)     :: x(:)
      real(RD), allocatable, intent(out)     :: y(:)
      character(3), allocatable, intent(out) :: label(:)

      integer :: n
      integer :: i0
      integer :: i0p
      integer :: i1
      integer :: i3m

      ! Evaluate r13 frequency ratios, following Roxburgh & Vorontsov
      ! (2003), eqn. (7)

      allocate(x(0))
      allocate(y(0))
      allocate(label(0))

      ! r13(n), at nu(n,1)

      do i1 = 1, fr(1)%n

         n = fr(1)%n_pg(i1)

         i3m = mode_index_(fr(3), n-1)
         i0 = mode_index_(fr(0), n)
         i0p = mode_index_(fr(0), n+1)

         if (i3m == 0 .OR. i0 == 0 .OR. i0p == 0) cycle

         x = [x, fr(1)%nu(i1)]
         y = [y, (fr(1)%nu(i1) - fr(3)%nu(i3m)) / (fr(0)%nu(i0p) - fr(0)%nu(i0))]
         label = [label, 'r13']

      end do

      ! Finish

      return

   end subroutine eval_r13_

   !****

   function mode_index_(fr, n) result(i)

      type(freqs_t), intent(in) :: fr
      integer, intent(in)       :: n
      integer                   :: i

      ! Return the index of the mode with radial order n, or 0 if
      ! there is no such mode

      if (fr%n > 0) then
         i = FINDLOC(fr%n_pg, n, DIM=1)
      else
         i = 0
      end if

      ! Finish

      return

   end function mode_index_

   !****

   function eval_ratios_deriv(fr, l, k, ratio_type) result(dr_dnu)

      type(freqs_t), intent(in) :: fr(0:)
      integer, intent(in)       :: l
      integer, intent(in)       :: k
      character(*), intent(in)  :: ratio_type
      real(RD), allocatable     :: dr_dnu(:)

      real(RD)       :: h
      type(freqs_t)  :: fr_a(0:UBOUND(fr, 1))
      type(freqs_t)  :: fr_b(0:UBOUND(fr, 1))
      type(ratios_t) :: rt_a
      type(ratios_t) :: rt_b

      ! Evaluate the derivative of ratios (of type ratio_type; see
      ! ratios_t_) with respect to the frequency fr(l)%nu(k), using
      ! finite differences

      ! Choose step size

      h = MAX(1E-5_RD*fr(l)%dnu(k), 1E-6_RD)

      ! Calculate offset frequencies

      fr_a = fr
      fr_a(l)%nu(k) = fr_a(l)%nu(k) - h

      fr_b = fr
      fr_b(l)%nu(k) = fr_b(l)%nu(k) + h

      ! Evaluate ratios at these frequencies

      rt_a = ratios_t(fr_a, ratio_type)
      rt_b = ratios_t(fr_b, ratio_type)

      ! Evaluate the derivative

      dr_dnu = (rt_b%ratio - rt_a%ratio) / (2._RD*h)

      ! Finish

      return

   end function eval_ratios_deriv

end module ratios_m
