real(RS) function userff (npar, data, myid)

   ! Uses

   use forum_m, only: RS, RD
   use em_m

   use ISO_FORTRAN_ENV

   ! No implicit typing

   implicit none (type, external)

   ! Variables

   integer, intent(in)  :: npar
   integer, intent(in)  :: myid
   real(RD), intent(in) :: data(:)

   integer :: unit
   integer :: n
   integer :: ns
   integer :: ll
   integer :: l0
   integer :: l1
   integer :: l2
   integer :: l3
   integer :: id
   integer :: t_code
   integer :: i
   integer :: j

   integer, dimension(5) :: spec

   integer, dimension(:), allocatable :: nl0
   integer, dimension(:), allocatable :: nl1
   integer, dimension(:), allocatable :: nl2
   integer, dimension(:), allocatable :: nl3

   character(len=1) :: lchr

   real(RD) :: f
   real(RD) :: e
   real(RD) :: Teff_o
   real(RD) :: Teff_e
   real(RD) :: logg_o
   real(RD) :: logg_e
   real(RD) :: FeH_o
   real(RD) :: FeH_e
   real(RD) :: R_o
   real(RD) :: R_e
   real(RD) :: L_o
   real(RD) :: L_e
   real(RD) :: Teff
   real(RD) :: logg
   real(RD) :: FeH
   real(RD) :: R
   real(RD) :: L
   real(RD) :: M_mod
   real(RD) :: Z_mod
   real(RD) :: Y_mod
   real(RD) :: alpha_mod
   real(RD) :: age
   real(RD) :: resid
   real(RD) :: chisq_r

   real(RD), dimension(:), allocatable :: nu0
   real(RD), dimension(:), allocatable :: dnu0
   real(RD), dimension(:), allocatable :: Enorm0
   real(RD), dimension(:), allocatable :: nu1
   real(RD), dimension(:), allocatable :: dnu1
   real(RD), dimension(:), allocatable :: Enorm1
   real(RD), dimension(:), allocatable :: nu2
   real(RD), dimension(:), allocatable :: dnu2
   real(RD), dimension(:), allocatable :: Enorm2
   real(RD), dimension(:), allocatable :: nu3
   real(RD), dimension(:), allocatable :: dnu3
   real(RD), dimension(:), allocatable :: Enorm3

   type(freq_t) :: fr_obs(0:3)
   type(freq_t) :: fr_mod(0:3)
   type(freq_t) :: fr_cor(0:3)

   @:CHECK_BOUNDS(SIZE(data), npar)

   ! Initialize EM

   call init_em()

   ! First pass to initialize arrays and set sizes

   open(NEWUNIT=unit, FILE='obs.dat', STATUS='old', ACTION='read')

   l0=0
   l1=0
   l2=0
   l3=0

   read(unit, *) n

   do i=1,n
      read(unit, *) ll
      if(ll == 0) l0=l0+1
      if(ll == 1) l1=l1+1
      if(ll == 2) l2=l2+1
      if(ll == 3) l3=l3+1
   enddo

   ns=0

   do i=1,5
      read(unit, *, END=50) lchr
      ns=ns+1
   enddo

50 close(unit)

   allocate ( nl0(l0) )
   allocate ( nl1(l1) )
   allocate ( nl2(l2) )
   allocate ( nl3(l3) )
   allocate ( nu0(l0) )
   allocate ( nu1(l1) )
   allocate ( nu2(l2) )
   allocate ( nu3(l3) )
   allocate ( dnu0(l0) )
   allocate ( dnu1(l1) )
   allocate ( dnu2(l2) )
   allocate ( dnu3(l3) )
   allocate ( Enorm0(l0) )
   allocate ( Enorm1(l1) )
   allocate ( Enorm2(l2) )
   allocate ( Enorm3(l3) )

   ! Read observational constraints

   open(NEWUNIT=unit, FILE='obs.dat', STATUS='old', ACTION='read')

   l0=0
   l1=0
   l2=0
   l3=0

   spec(1)=0
   spec(2)=0
   spec(3)=0
   spec(4)=0
   spec(5)=0

   read(unit, *) n

   do i=1,n+ns
      ll=-1
      read(unit,*) lchr,f,e
      if (lchr == "T") then
         Teff_o=f
         Teff_e=e
         spec(1)=1
      elseif (lchr == "G") then
         logg_o=f
         logg_e=e
         spec(2)=1
      elseif (lchr == "M") then
         FeH_o=f
         FeH_e=e
         spec(3)=1
      elseif (lchr == "R") then
         R_o=f
         R_e=e
         spec(4)=1
      elseif (lchr == "L") then
         L_o=f
         L_e=e
         spec(5)=1
      else
         read(lchr,*) ll
         if(ll == 0) then
            l0=l0+1
            nl0(l0)=l0
            nu0(l0)=f
            dnu0(l0)=e
            Enorm0(l0)=1.d0
         elseif(ll == 1) then
            l1=l1+1
            nl1(l1)=l1
            nu1(l1)=f
            dnu1(l1)=e
            Enorm1(l1)=1.d0
         elseif(ll == 2) then
            l2=l2+1
            nl2(l2)=l2
            nu2(l2)=f
            dnu2(l2)=e
            Enorm2(l2)=1.d0
         elseif(ll == 3) then
            l3=l3+1
            nl3(l3)=l3
            nu3(l3)=f
            dnu3(l3)=e
            Enorm3(l3)=1.d0
         endif
      endif
   enddo

   close(unit)

   fr_obs(0) = freq_t(nu0,dnu0,Enorm0,nl0)
   fr_obs(1) = freq_t(nu1,dnu1,Enorm1,nl1)
   fr_obs(2) = freq_t(nu2,dnu2,Enorm2,nl2)
   fr_obs(3) = freq_t(nu3,dnu3,Enorm3,nl3)

   call set_obs_freqs(0, fr_obs(0))
   call set_obs_freqs(1, fr_obs(1))
   call set_obs_freqs(2, fr_obs(2))
   call set_obs_freqs(3, fr_obs(3))

   ! Create a star

   M_mod = 1.0_RD*data(1)+0.75_RD
   Z_mod = 10._RD**(0.8_RD*data(2)-2.1_RD)
   Y_mod = 0.10_RD*data(3)+0.22_RD
   alpha_mod = 2.0_RD*data(4)+1.0_RD

   if (myid == 0) print *, 'M,Z,Y,alpha:', M_mod, Z_mod, Y_mod, alpha_mod

   id = create_star( &
      M = M_mod, &
      Y = Y_mod, &
      Z = Z_mod, &
      alpha = alpha_mod, &
      f_ov=0.0_RD, &
      max_age=1.5e10_RD)

   ! Evolve it to the ZAMS

   call evolve_star_to_zams(id, t_code)

   ! Evolve it until seismic constraints are met

   call evolve_star_seismic(id, t_code, log_g_min=3.75_RD)

   ! Get model frequencies

   fr_mod(0) = get_mod_freqs(0)
   fr_mod(1) = get_mod_freqs(1)
   fr_mod(2) = get_mod_freqs(2)
   fr_mod(3) = get_mod_freqs(3)

   if (ANY(fr_mod%n > 0)) then

      ! Get model data

      call get_mod_data(Teff, logg, FeH, R, L, age)

      if (myid == 0) print *,'Teff: ',Teff
      if (myid == 0) print *,'logg: ',logg
      if (myid == 0) print *,' FeH: ',FeH
      if (myid == 0) print *,'R/Ro: ',R
      if (myid == 0) print *,'L/Lo: ',L
      if (myid == 0) print *,' age: ',age

      ! Calculate spectroscopic chisq

      chisq_r=0._RD

      if (spec(1) == 1) chisq_r = chisq_r + (Teff_o-Teff)*(Teff_o-Teff)/(Teff_e*Teff_e)
      if (spec(2) == 1) chisq_r = chisq_r + (logg_o-logg)*(logg_o-logg)/(logg_e*logg_e)
      if (spec(3) == 1) chisq_r = chisq_r + (FeH_o-FeH)*(FeH_o-FeH)/(FeH_e*FeH_e)
      if (spec(4) == 1) chisq_r = chisq_r + (R_o-R)*(R_o-R)/(R_e*R_e)
      if (spec(5) == 1) chisq_r = chisq_r + (L_o-L)*(L_o-L)/(L_e*L_e)

      ! Get corrected frequencies

      call apply_combined_correction(fr_mod, fr_obs, fr_cor)

      ! Calculate seismic chisq

      do i = 0, 3
         do j = 1, fr_obs(i)%n
            resid = (fr_obs(i)%nu(j)-fr_cor(i)%nu(j))/fr_obs(i)%dnu(j)
            chisq_r = chisq_r + resid*resid
            if(myid == 0) print *, i, fr_mod(i)%n_pg(j), fr_obs(i)%nu(j), fr_obs(i)%dnu(j), fr_cor(i)%nu(j), resid
         end do
      end do

      userff = float(n+ns-5)/chisq_r

   else

      userff = TINY(0._RS)

   endif

   ! Destroy the star

   call destroy_star(id)

   ! Finalize EM

   call final_em()

end function userff

