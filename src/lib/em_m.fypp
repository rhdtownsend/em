! Module  : em_m
! Purpose : Embedded MESA (EM) library
!
! Copyright 2016-2026 Rich Townsend

#:include 'em.inc'

module em_m

   ! Uses

   use forum_m, only: RD
   use gyre_m, only: init_math

   use freq_m
   use em_gyre_m
   use em_mesa_m

   use ISO_FORTRAN_ENV

   ! No implicit typing

   implicit none

   ! Module variables

   real(RD), save :: Teff_m  ! Effective temperature of best model
   real(RD), save :: logg_m  ! Surface gravity of best model
   real(RD), save :: FeH_m   ! Metallicity of best model
   real(RD), save :: R_m     ! Radius of best model
   real(RD), save :: L_m     ! Luminosity of best model
   real(RD), save :: age_m   ! Age of best model
   real(RD), save :: Rcz_m   ! Rcz/Rsun of best model

   ! Interfaces

   ! This overload (see also evolve_star_seismic_process_ in
   ! em_mesa_m) allows us to preserve the legacy interface for
   ! evolve_star_seismic

   interface evolve_star_seismic
      module procedure evolve_star_seismic_legacy_
   end interface evolve_star_seismic

   ! Access specifiers

   private

   public :: RD
   public :: init_em
   public :: final_em
   public :: create_star
   public :: evolve_star_to_zams
   public :: evolve_star_to_log_g
   public :: evolve_star_seismic
   public :: destroy_star
   public :: freq_t
   public :: set_obs_freqs
   public :: get_mod_freqs
   public :: get_mod_data
   public :: apply_cubic_correction
   public :: apply_combined_correction
   public :: t_ok
   public :: t_max_age

contains

   subroutine init_em()

      integer :: l

      ! Initialize

      do l = 0, L_MAX
         call set_obs_freqs(l, freq_t())
      end do

      call init_math()

      ! Finish

      return

   end subroutine init_em

   !****

   subroutine final_em ()

      ! Finalize

      call starlib_shutdown()

      ! Finish

      return

   end subroutine final_em

   !****

   subroutine evolve_star_seismic_legacy_(id, t_code, f_enter, f_exit, y_tol, dt_frac, log_g_min, best_profile_filename)

      integer, intent(in)                :: id
      integer, intent(out)               :: t_code
      real(RD), intent(in), optional     :: f_enter
      real(RD), intent(in), optional     :: f_exit
      real(RD), intent(in), optional     :: y_tol
      real(RD), intent(in), optional     :: dt_frac
      real(RD), intent(in), optional     :: log_g_min
      character(*), intent(in), optional :: best_profile_filename

      ! Clear model data

      Teff_m = 0._RD
      logg_m = 0._RD
      FeH_m = 0._RD
      R_m = 0._RD
      L_m = 0._RD
      age_m = 0._RD
      Rcz_m = 0._RD

      ! Evolve the star

      call evolve_star_seismic(id, t_code, store_mod_data_, f_enter, f_exit, y_tol, dt_frac, log_g_min)

      ! Finish

      return

   contains

      subroutine store_mod_data_(Teff, logg, FeH, R, L, age, Rcz)

         real(RD), intent(in) :: Teff
         real(RD), intent(in) :: logg
         real(RD), intent(in) :: FeH
         real(RD), intent(in) :: R
         real(RD), intent(in) :: L
         real(RD), intent(in) :: age
         real(RD), intent(in) :: Rcz

         integer :: ierr

         ! Store model data

         Teff_m = Teff
         logg_m = logg
         FeH_m = FeH
         R_m = R
         L_m = L
         age_m = age
         Rcz_m = Rcz

         ! Optionally write out the model

         if (PRESENT(best_profile_filename)) then
            call star_write_profile_info( &
               id, best_profile_filename, &
               ierr)
            @:ASSERT(ierr == 0, 'failed in star_write_profile_info')
         end if

         ! Finish

         return

      end subroutine store_mod_data_

   end subroutine evolve_star_seismic_legacy_

   !****

   subroutine get_mod_data(Teff, logg, FeH, R, L, age)

      real(RD), intent(out) :: Teff
      real(RD), intent(out) :: logg
      real(RD), intent(out) :: FeH
      real(RD), intent(out) :: R
      real(RD), intent(out) :: L
      real(RD), intent(out) :: age

      ! Return best-fit model data

      Teff = Teff_m
      logg = logg_m
      FeH = FeH_m
      R = R_m
      L = L_m
      age = age_m

      ! Finish

      return

   end subroutine get_mod_data

end module em_m
